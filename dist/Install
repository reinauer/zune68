; $VER: Install-Zune68 1.3 (18.11.2026)
; Run with Amiga Installer 43 or newer.

(set @app-name "Zune68")
(set @default-dest "")
(if (< @installer-version (* 43 65536))
    (abort "Zune68 installation requires Amiga Installer 43 or newer.")
)
(welcome "Install Zune68's native AmigaOS libraries.")
; Components install without questions. Novice mode would also skip the
; choice between installing and Set back and the drawer for MUI:, so
; raise the level to Average. Installer's own level only changes through
; (user); setting @user-level changes the variable, not the behaviour.
(if (< @user-level 1) (user 1))
(set #package (pathonly @icon))
(set #release "[RELEASE]")
(set #selected 0)
(set #restored 0)
(set #log "")
(set #action "install")

; Where things are. The first LIBS: directory is where libraries are
; installed and where older class copies would hide MUI:Libs/MUI.
(set #syslibs (expandpath "LIBS:"))
(set #muiroot (getassign "MUI" "a"))
(if (= #syslibs "") (set #syslibs "SYS:Libs"))
(if (= #muiroot "")
    (if (= (exists "SYS:MUI/Zune68" (noreq)) 2)
        (set #muiroot (expandpath "SYS:MUI"))
    )
)
(set #state "")
(set #muiclasses "")
(set #shadowclasses "")

; Recompute the derived locations after #muiroot changes.
(procedure P_Locations
    (if (<> #muiroot "")
        (
            (set #state (tackon #muiroot "Zune68"))
            (set #muiclasses (tackon #muiroot "Libs/MUI"))
        )
    )
    (set #shadowclasses (tackon #syslibs "MUI"))
    (if (<> #muiclasses "")
        (if (= (expandpath #shadowclasses) (expandpath #muiclasses))
            (set #shadowclasses "")
        )
    )
)
(P_Locations)

(procedure P_Version #number
    ("%ld.%ld" (/ #number 65536) (bitand #number 65535))
)

; The protocol is kept in memory and appended to MUI:Zune68/Install.log at
; the end of the run, or when the run is aborted.
(procedure P_Log #line
    (set #log (cat #log #line "\n"))
)

(procedure P_WriteLog
    (if (and (<> #log "") (= @pretend 0))
        (if (= (exists #state (noreq)) 2)
            (
                (set #logfile (tackon #state "Install.log"))
                (if (= (exists #logfile (noreq)) 1)
                    (textfile (dest "T:Zune68-Install.log") (include #logfile)
                        (append ("\n--- Zune68 %s: %s ---\n" #release #action) #log))
                    (textfile (dest "T:Zune68-Install.log")
                        (append ("--- Zune68 %s: %s ---\n" #release #action) #log))
                )
                (copyfiles (source "T:Zune68-Install.log") (dest #state)
                    (newname "Install.log") (optional "force" "nofail"))
                (delete "T:Zune68-Install.log" (optional "nofail"))
                (set #log "")
            )
        )
    )
)

(onerror (P_WriteLog))

; Markers in MUI:Zune68/Created and MUI:Zune68/Replaced record which files
; Zune68 added and which originals it saved, so that Set back can remove
; exactly those. Their paths mirror the installed files.
(procedure P_StatePath #tree #key
    (if (or (= #key "") (= #state ""))
        ""
        (tackon (tackon #state #tree) #key)
    )
)

(procedure P_Mark #marker #content
    (if (<> #marker "")
        (textfile (dest #marker) (append #content "\n"))
    )
)

(procedure P_StateDirs
    (makedir #state)
    (makedir (tackon #state "Created"))
    (makedir (tackon #state "Replaced"))
    (makedir (P_StatePath "Created" "Libs"))
    ; COMPONENT_STATEDIRS
)

; Install a component without asking. A file that Zune68 did not install
; is saved once as .zune68-old before it is replaced, whatever its
; version; Set back restores it. #shadowdir names a directory searched
; before #directory, such as the first LIBS: directory for classes in
; MUI:Libs/MUI. A copy there would hide the installed file, so it is
; renamed to .zune68-old.
(procedure P_InstallFile #relative #directory #residentname #key #shadowdir
    (set #name (fileonly #relative))
    (set #source (tackon #package #relative))
    (set #destination (tackon #directory #name))
    (set #backup (cat #destination ".zune68-old"))
    (set #created (P_StatePath "Created" #key))
    (set #shadow "")
    (if (<> #shadowdir "")
        (if (= (exists (tackon #shadowdir #name) (noreq)) 1)
            (set #shadow (tackon #shadowdir #name))
        )
    )
    (set #bundled (getversion #source))
    (set #existing (exists #destination (noreq)))
    (if (= #existing 2)
        (abort (cat #destination " is a directory, not a component file."))
    )
    (if (= (exists #backup (noreq)) 2)
        (abort (cat #backup " is a directory. No file was replaced."))
    )
    (set #ours 0)
    (if (<> #created "")
        (if (= (exists #created (noreq)) 1) (set #ours 1))
    )
    (set #current #destination)
    (if (<> #shadow "") (set #current #shadow))
    (set #replaced "")
    (if (or #existing (<> #shadow ""))
        (
            (set #installed (getversion #current))
            (if #installed
                (set #replaced (cat ", replacing v" (P_Version #installed)))
                (set #replaced ", replacing a file of unknown version")
            )
        )
    )
    (makedir #directory)
    (if (<> #shadow "")
        (if (exists (cat #shadow ".zune68-old") (noreq))
            (
                (delete #shadow (optional "force"))
                (P_Log (cat "Deleted " #shadow
                    " (its .zune68-old backup is older and kept)"))
            )
            (
                (rename #shadow (cat #shadow ".zune68-old"))
                (P_Log (cat "Renamed " #shadow " to " #name ".zune68-old"
                    " (it hid " #directory ")"))
            )
        )
    )
    (if (and #existing (= #ours 0))
        (if (= (exists #backup (noreq)) 0)
            (
                (copyfiles
                    (source #destination)
                    (dest #directory)
                    (newname (cat #name ".zune68-old"))
                    (optional "fail")
                )
                (P_Log (cat "Saved " #destination " as " #name ".zune68-old"))
            )
        )
    )
    (copyfiles
        (source #source)
        (dest #directory)
        (optional "fail")
    )
    (if (= #existing 0)
        (if (= (exists #backup (noreq)) 0)
            (P_Mark #created #destination)
        )
    )
    (P_Log (cat "Installed " #destination " v" (P_Version #bundled) #replaced))
    (if #residentname
        (
            (set #resident (getversion #residentname (resident)))
            (if #resident
                (P_Log (cat #name " v" (P_Version #resident)
                    " stays in memory until reboot"))
            )
        )
    )
    (if (exists (cat #source ".info"))
        (
            (set #iconreplaced (P_StatePath "Replaced" (cat #key ".info")))
            (set #iconcreated (P_StatePath "Created" (cat #key ".info")))
            (if (exists (cat #destination ".info") (noreq))
                (if (= (exists (cat #destination ".info.old") (noreq)) 0)
                    (if (= (exists #iconcreated (noreq)) 0)
                        (
                            (copyfiles (source (cat #destination ".info"))
                                (dest #directory) (newname (cat #name ".info.old"))
                                (optional "fail"))
                            (P_Mark #iconreplaced (cat #destination ".info"))
                        )
                    )
                )
                (if (= (exists #iconreplaced (noreq)) 0)
                    (P_Mark #iconcreated (cat #destination ".info"))
                )
            )
            (copyfiles (source (cat #source ".info"))
                (dest #directory) (optional "fail"))
        )
    )
    (set #selected (+ #selected 1))
)

(procedure P_InstallLibrary #library
    (P_InstallFile (tackon "Libs" #library) #syslibs #library
        (tackon "Libs" #library) "")
)

; Support files have no library identity; keep one short .old backup.
(procedure P_CopySupport #relative #directory #key
    (set #filename (fileonly #relative))
    (set #target (tackon #directory #filename))
    (set #replaced (P_StatePath "Replaced" #key))
    (set #created (P_StatePath "Created" #key))
    (makedir #directory)
    (if (exists #target (noreq))
        (if (= (exists (cat #target ".old") (noreq)) 0)
            (if (= (exists #created (noreq)) 0)
                (
                    (copyfiles (source #target) (dest #directory)
                        (newname (cat #filename ".old")) (optional "fail"))
                    (P_Mark #replaced #target)
                    (P_Log (cat "Saved " #target " as " #filename ".old"))
                )
            )
        )
        (if (= (exists #replaced (noreq)) 0)
            (P_Mark #created #target)
        )
    )
    (copyfiles (source (tackon #package #relative)) (dest #directory)
        (optional "fail"))
    (P_Log (cat "Installed " #target))
    (set #selected (+ #selected 1))
)

; Set back: put a .zune68-old backup back in place, or delete a file that
; Zune68 added. #ours treats a file without backup as added by Zune68.
(procedure P_RestoreFile #directory #name #key #ours
    (set #destination (tackon #directory #name))
    (set #backup (cat #destination ".zune68-old"))
    (set #created (P_StatePath "Created" #key))
    (set #added #ours)
    (if (<> #created "")
        (if (= (exists #created (noreq)) 1) (set #added 1))
    )
    (if (= (exists #backup (noreq)) 1)
        (
            (if (exists #destination (noreq))
                (delete #destination (optional "force"))
            )
            (rename #backup #destination)
            (P_Log (cat "Restored " #destination " from " #name ".zune68-old"))
            (set #restored (+ #restored 1))
        )
        (if (= (exists #destination (noreq)) 1)
            (if #added
                (
                    (delete #destination (optional "force"))
                    (P_Log (cat "Removed " #destination))
                    (set #restored (+ #restored 1))
                )
                (P_Log (cat "Kept " #destination " (no record that Zune68 installed it)"))
            )
        )
    )
    (if (<> #created "")
        (delete #created (optional "nofail"))
    )
)

(procedure P_RestoreSupport #directory #name #key
    (set #target (tackon #directory #name))
    (set #replaced (P_StatePath "Replaced" #key))
    (set #created (P_StatePath "Created" #key))
    (if (= (exists #replaced (noreq)) 1)
        (
            (if (= (exists (cat #target ".old") (noreq)) 1)
                (
                    (if (exists #target (noreq))
                        (delete #target (optional "force"))
                    )
                    (rename (cat #target ".old") #target)
                    (P_Log (cat "Restored " #target " from " #name ".old"))
                    (set #restored (+ #restored 1))
                )
            )
            (delete #replaced (optional "nofail"))
        )
        (if (= (exists #created (noreq)) 1)
            (
                (if (= (exists #target (noreq)) 1)
                    (
                        (delete #target (optional "force"))
                        (P_Log (cat "Removed " #target))
                        (set #restored (+ #restored 1))
                    )
                )
                (delete #created (optional "nofail"))
            )
        )
    )
)

(procedure P_RestoreMUI
    (if (= (exists (P_StatePath "Created" "Assign") (noreq)) 1)
        (
            (startup "Zune68"
                (prompt "Disable the Zune68 section of S:User-Startup?")
                (help "Zune68 added this section to assign MUI: at boot."
                      "Its commands are replaced by a comment.")
                (command "; Zune68 was set back. This section can be deleted."))
            (run ("Assign LIBS: \"%s\" REMOVE" (tackon #muiroot "Libs")))
            (makeassign "MUI")
            (delete (P_StatePath "Created" "Assign") (optional "nofail"))
            (delete (tackon #muiroot "Libs/MUI") (optional "nofail"))
            (delete (tackon #muiroot "Libs") (optional "nofail"))
            (P_Log (cat "Removed the MUI: assign to " #muiroot
                " and disabled the Zune68 section of S:User-Startup"))
            (set #muiremoved 1)
        )
    )
)

; Check the entire payload before offering any system changes.
(if (or
        (<> (exists (tackon #package "Libs/zunemaster.library")) 1)
        (<> (exists (tackon #package "Libs/muimaster.library")) 1)
    )
    (abort "The package is incomplete. Extract the complete Zune68 archive.")
)
(foreach (tackon #package "Libs") "#?.library"
    (if (and (= (exists (tackon (tackon #package "Libs") @each-name)) 1)
             (= (getversion (tackon (tackon #package "Libs") @each-name)) 0))
        (abort (cat "Cannot read the bundled version of " @each-name "."))
    )
)

; COMPONENT_PREFLIGHT

(set #previous 0)
(if (<> #state "")
    (if (= (exists #state (noreq)) 2) (set #previous 1))
)
(if (exists (tackon #syslibs "zunemaster.library") (noreq)) (set #previous 1))
(if (exists (tackon #syslibs "muimaster.library.zune68-old") (noreq)) (set #previous 1))

(set #mode 0)
(if #previous
    (set #mode (askchoice
        (prompt "Zune68 has been installed on this system before.\n\n"
                "Set back puts the saved originals back in place and\n"
                "removes the files Zune68 added, returning to the\n"
                "MUI setup that was there before Zune68.")
        (help "Install or update installs every component and saves the"
              "files it replaces. Set back uses the backups and the records in"
              "MUI:Zune68. Files that were not recorded are kept. The protocol"
              "of every run is in MUI:Zune68/Install.log.")
        (choices "Install or update Zune68" "Set back to the state before Zune68")
        (default 0)))
)

(if (= #mode 1)
    (
        (set #action "set back")
        (set #muiremoved 0)
        (P_RestoreFile #syslibs "zunemaster.library" "Libs/zunemaster.library" 1)
        (P_RestoreFile #syslibs "muimaster.library" "Libs/muimaster.library" 0)
        ; COMPONENT_RESTORE
        (if (<> #state "") (P_RestoreMUI))
        (P_WriteLog)
        (if @pretend
            (message "Pretend mode finished. No files were changed.")
            (message ("Set back %ld file(s).\n\n" #restored)
                (if (<> #state "")
                    (cat "The protocol is in " (tackon #state "Install.log") ".\n")
                    "")
                (if #muiremoved
                    (cat "MUI: is no longer assigned. You can delete\n" #muiroot
                        " once you no longer need the protocol.\n")
                    "")
                "\nClose applications and reboot to use the restored libraries.")
        )
        (exit (quiet))
    )
)

; MUI classes belong in MUI:Libs/MUI. Without a MUI: assign, create one
; and add it to S:User-Startup like MUI does.
(set #muinew 0)
(if (= (getassign "MUI" "a") "")
    (
        (if (= #muiroot "") (set #muiroot "SYS:MUI"))
        (set #muiroot (askdir
            (prompt "MUI: is not assigned. Zune68 installs its classes to\n"
                    "MUI:Libs/MUI, where MUI applications and class\n"
                    "installers look for them.\n\n"
                    "Choose the drawer to use as MUI:. It is created if\n"
                    "needed, and S:User-Startup gets a Zune68 section:\n"
                    "  Assign MUI: <drawer>\n  Assign LIBS: MUI:Libs ADD")
            (help "MUI keeps its files in the drawer assigned to MUI: and adds"
                  "MUI:Libs to LIBS:, so that classes in MUI:Libs/MUI are found."
                  "Zune68 sets up the same layout. Set back removes it again.")
            (default #muiroot)
            (newpath)))
        (makedir #muiroot)
        (makedir (tackon #muiroot "Libs"))
        (makedir (tackon #muiroot "Libs/MUI"))
        (if (= @pretend 0)
            (if (= (exists #muiroot (noreq)) 2)
                (set #muiroot (expandpath #muiroot))
            )
        )
        (makeassign "MUI" #muiroot)
        (run ("Assign LIBS: \"%s\" ADD" (tackon #muiroot "Libs")))
        (startup "Zune68"
            (prompt "Add the MUI: assign to S:User-Startup?")
            (help "Without these lines MUI: is gone after the next boot, and"
                  "applications do not find the classes in MUI:Libs/MUI.")
            (command ("Assign MUI: \"%s\"\nAssign LIBS: MUI:Libs ADD\n" #muiroot)))
        (set #muinew 1)
    )
)
(P_Locations)
(P_StateDirs)
(if #muinew
    (
        (P_Mark (P_StatePath "Created" "Assign") #muiroot)
        (P_Log (cat "Assigned MUI: to " #muiroot
            ", added MUI:Libs to LIBS: and a Zune68 section to S:User-Startup"))
    )
)

(P_InstallLibrary "zunemaster.library")
(complete 50)
(P_InstallLibrary "muimaster.library")
; COMPONENT_INSTALL
(complete 100)
(P_WriteLog)

(if @pretend
    (message "Pretend mode finished. No files were copied.")
    (message ("Installed %ld component file(s).\n" #selected)
        "Replaced files were saved as .zune68-old or .old.\n"
        "Close applications and reboot before using the new libraries.\n\n"
        "The protocol is in " (tackon #state "Install.log") ".\n"
        "To undo, run Install again and choose Set back.\n\n"
        "Examples, SDK, documentation and source stay in the\n"
        "extracted Zune68 drawer. No SDK assigns are changed.")
)
